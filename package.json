{
	"name": "fantalies",
	"version": "0.0.1",
	"private": true,
	"scripts": {
		"dev": "vite dev --host --port 3000",
		"build": "vite build",
		"preview": "vite preview",
		"test": "npm run test:integration && npm run test:unit",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:integration": "playwright test",
		"test:unit": "vitest",
		"coverage": "vitest run --coverage --mode testing",
		"prepare": "husky",
		"build:docker": "docker build -t fantalies .",
		"start:docker": "./src/scripts/docker/index.sh --remove",
		"machine-translate": "inlang machine translate --project project.inlang"
	},
	"devDependencies": {
		"@commitlint/config-conventional": "^19.5.0",
		"@inlang/cli": "^3.0.0",
		"@inlang/paraglide-js": "2.0.13",
		"@playwright/test": "^1.28.1",
		"@sveltejs/adapter-auto": "^3.0.0",
		"@sveltejs/kit": "^2.6.1",
		"@sveltejs/vite-plugin-svelte": "^4.0.0-next.6",
		"@tailwindcss/aspect-ratio": "^0.4.2",
		"@tailwindcss/forms": "^0.5.10",
		"@tailwindcss/typography": "^0.5.16",
		"@testing-library/jest-dom": "^6.5.0",
		"@types/eslint": "^9.6.0",
		"@vitest/coverage-v8": "^2.1.1",
		"autoprefixer": "^10.4.20",
		"commitlint": "^19.5.0",
		"eslint": "^9.0.0",
		"eslint-config-prettier": "^9.1.0",
		"eslint-plugin-svelte": "^2.36.0",
		"eslint-plugin-unused-imports": "^4.1.4",
		"globals": "^15.0.0",
		"husky": "^9.1.6",
		"jsdom": "^25.0.1",
		"lint-staged": "^15.2.10",
		"prettier": "^3.1.1",
		"prettier-plugin-svelte": "^3.1.2",
		"prettier-plugin-tailwindcss": "^0.6.5",
		"saos": "^1.3.1",
		"svelte": "^5.0.0",
		"svelte-check": "^4.0.0",
		"tailwindcss": "^3.4.9",
		"typescript": "^5.0.0",
		"typescript-eslint": "^8.0.0",
		"vite": "^5.0.3",
		"vitest": "^2.0.0"
	},
	"type": "module",
	"dependencies": {
		"@inlang/paraglide-js-adapter-sveltekit": "^0.6.7",
		"@lucide/svelte": "^0.511.0",
		"@sveltejs/adapter-node": "^5.2.5",
		"axios": "^1.7.7",
		"svelte-motion": "^0.12.2"
	}
}
